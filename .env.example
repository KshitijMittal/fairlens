# Database
DATABASE_URL=

# Backend API (Hugging Face Gradio Space)
API_ORIGIN=
API_HOST=0.0.0.0
API_PORT=7860
ENV=local

# Deploy only (never read by the app)
HF_TOKEN=
PROBE_TOKEN=

# Auth: sessions
SESSION_SECRET=

# Auth: Google OAuth (optional if using Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth: password reset over Brevo's HTTPS API (optional - see G2)
BREVO_API_KEY=
BREVO_SENDER=

# LLM narrative generation (optional - template works without)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rate limiting pepper (required)
RATE_LIMIT_PEPPER=

# Feature flags
NEXT_PUBLIC_ANALYSIS_STREAMING=1
