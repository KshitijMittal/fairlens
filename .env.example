# Database
DATABASE_URL=

# Backend API (Hugging Face Space)
API_ORIGIN=
API_HOST=0.0.0.0
API_PORT=7860
ENV=local

# Auth: sessions
SESSION_SECRET=

# Auth: Google OAuth (optional if using Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth: password reset over SMTP (optional - see G2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Fallback: Brevo SMTP API (alternative to Gmail)
BREVO_API_KEY=
BREVO_SENDER=

# LLM narrative generation (optional - template works without)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Rate limiting pepper (required)
RATE_LIMIT_PEPPER=

# Feature flags
NEXT_PUBLIC_ANALYSIS_STREAMING=1
