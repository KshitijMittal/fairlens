# Database
DATABASE_URL=
# Direct (non-pooled) connection for migrations; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=

# Backend API (Hugging Face Gradio Space)
API_ORIGIN=
API_HOST=0.0.0.0
API_PORT=7860
APP_ORIGIN=http://localhost:3000
ENV=development

# Deploy only (never read by the app)
HF_TOKEN=

# Auth: Google OAuth (optional - sign-in is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth: password reset over Brevo's HTTPS API (optional - see G2)
BREVO_API_KEY=
BREVO_SENDER=

# LLM narrative generation (M6, optional - template works without)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
